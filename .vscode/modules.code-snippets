{
  "mod-schema": {
    "prefix": "mod-schema",
    "scope": "typescript,typescriptreact",
    "description": "模块 schema.ts——drizzle 表 + 推导 zod(数据不变量)",
    "body": [
      "/**",
      " * 文件作用:${1:模块中文名}域的 drizzle 表定义与入参 zod 契约。",
      " *",
      " * 成员:",
      " * 1. ${2:实体中文}表(${3:entityName}):一句话说明;",
      " * 2. ${4:xxx}入参 schema(${5:xxxInputSchema}):结构与字段规则;",
      " * 3. ${4:xxx}入参类型(${6:XxxInput}):入参 schema 的推断类型。",
      " *",
      " * 其他:",
      " * 1. 列属性名 camelCase,DB 列名 snake_case 在表定义时烘焙",
      " *    (drizzle-orm 1.0 RC 行为,禁止运行时 casing 选项);",
      " * 2. zod 契约与表定义同文件:校验单一来源,前后端共用;",
      " * 3. zod message 直接承载 i18n key,action 只返回错误 key 不返回文案;",
      " * 4. 不建跨模块 DB 级 FK,账号隔离由应用层 user_id 过滤保证;",
      " * 5. 建表后在 src/db/schema.ts barrel 追加一行 export * re-export。",
      " */",
      "import {",
      "  index,",
      "  snakeCase,",
      "  text,",
      "  timestamp,",
      "  uuid,",
      "} from \"drizzle-orm/pg-core\";",
      "import { z } from \"zod\";",
      "",
      "const pgTable = snakeCase.table;",
      "",
      "/**",
      " * 作用:${2:实体中文}表。${7:一句话说明}",
      " */",
      "export const ${3:entityName} = pgTable(",
      "  \"${8:snake_table_name}\",",
      "  {",
      "    id: uuid().primaryKey().defaultRandom(),",
      "    userId: text().notNull(),",
      "    // ${9:业务列}",
      "    createdAt: timestamp({ withTimezone: true }).notNull().defaultNow(),",
      "    updatedAt: timestamp({ withTimezone: true }).notNull().defaultNow(),",
      "  },",
      "  (t) => [index(\"${8:snake_table_name}_user\").on(t.userId)],",
      ");",
      "",
      "/**",
      " * 作用:${4:xxx}入参校验。校验规则:",
      " * 1. ${10:规则};",
      " */",
      "export const ${5:xxxInputSchema} = z.object({",
      "  ${11:field}: z.string().min(1),",
      "});",
      "",
      "export type ${6:XxxInput} = z.infer<typeof ${5:xxxInputSchema}>;",
      "$0",
    ],
  },
  "mod-queries": {
    "prefix": "mod-queries",
    "scope": "typescript,typescriptreact",
    "description": "模块 queries.ts——读路径,RSC 页面直接调用",
    "body": [
      "/**",
      " * 文件作用:${1:模块中文名}读路径的数据库查询,RSC 页面直接调用。",
      " *",
      " * 成员:",
      " * 1. ${2:视图中文}查询(${3:listXxx}):一句话说明;",
      " * 2. ${2:视图中文}视图(${4:XxxView}):单行结构。",
      " *",
      " * 其他:",
      " * 1. 仅本人可见:查询恒带 userId 条件,不收客户端未过滤集合;",
      " * 2. 返回类型显式声明,禁止 Awaited<ReturnType<…>> 推断;",
      " * 3. 数据库异常向上抛,页面渲染失败由 Next 错误边界兜底,本层不做归一;",
      " * 4. 多查询共用的主体下沉为私有函数(沉底),跨模块复用经 index.ts 顶出口导出。",
      " */",
      "import { and, eq } from \"drizzle-orm\";",
      "",
      "import { db } from \"@/db/client\";",
      "",
      "import { ${5:entityName} } from \"./schema\";",
      "",
      "/** 作用:按账号读${6:范围},排序为${7:排序规则}。 */",
      "export async function ${3:listXxx}(",
      "  userId: string,",
      "  ${8:参数}: ${9:类型},",
      "): Promise<${4:XxxView}[]> {",
      "  const rows = await db",
      "    .select({",
      "      id: ${5:entityName}.id,",
      "      // ${10:选择列}",
      "    })",
      "    .from(${5:entityName})",
      "    .where(and(eq(${5:entityName}.userId, userId)));",
      "",
      "  return rows;",
      "}",
      "",
      "/** 作用:${2:视图中文}视图的单行结构。 */",
      "export type ${4:XxxView} = {",
      "  id: string;",
      "  // ${11:视图字段}",
      "};",
      "$0",
    ],
  },
  "mod-actions": {
    "prefix": "mod-actions",
    "scope": "typescript,typescriptreact",
    "description": "模块 actions.ts——'use server' Server Functions(判别联合返回,胶水经 @/lib/action)",
    "body": [
      "\"use server\";",
      "",
      "/**",
      " * 文件作用:${1:模块中文名}模块的 Server Actions 入口,衔接前端调用与读写 service。",
      " *",
      " * 成员:",
      " * 1. ${2:操作中文}结果(${3:XxxActionResult}):${2:操作中文}的统一结果类型;",
      " * 2. ${2:操作中文}动作(${4:xxxAction}):一句话说明。",
      " *",
      " * 其他:",
      " * 1. 'use server' 文件仅可导出 async 函数,纯类型导出除外;",
      " * 2. userId 一律取自会话(getCurrentSession),不收客户端传入;",
      " * 3. 归一流胶水(会话校验/复验/异常归一/缓存刷新)由 @/lib/action 单一来源提供;",
      " * 4. fieldErrors 只装错误 key,不返回文案原文。",
      " */",
      "import { ActionResult, runAction } from \"@/lib/action\";",
      "import { ROUTES } from \"@/lib/routes\";",
      "import { getCurrentSession } from \"@/modules/auth\";",
      "",
      "import {",
      "  ${5:xxxInputSchema},",
      "  type ${6:XxxInput},",
      "  type ${7:XxxFieldErrors},",
      "} from \"./schema\";",
      "import { ${8:updateXxx} } from \"./service\";",
      "",
      "export type ${3:XxxActionResult} = ActionResult<${7:XxxFieldErrors}>;",
      "",
      "/** 作用:${2:操作中文},走统一归一流。 */",
      "export async function ${4:xxxAction}(",
      "  input: ${6:XxxInput},",
      "): Promise<${3:XxxActionResult}> {",
      "  return runAction(",
      "    await getCurrentSession(),",
      "    input,",
      "    ${5:xxxInputSchema},",
      "    (userId, data) => ${8:updateXxx}(userId, data),",
      "    ${9:ROUTES.xxx},",
      "  );",
      "}",
      "$0",
    ],
  },
  "mod-service": {
    "prefix": "mod-service",
    "scope": "typescript,typescriptreact",
    "description": "模块 service.ts——写路径、事务、业务规则",
    "body": [
      "/**",
      " * 文件作用:${1:模块中文名}域的写路径,提供${2:实体中文}的单行增删改。",
      " *",
      " * 成员:",
      " * 1. 新建${2:实体中文}(create${4:Xxx}):单行 INSERT 写入一条${2:实体中文};",
      " * 2. 更新${2:实体中文}(update${4:Xxx}):单行 UPDATE,条件含归属校验;",
      " * 3. 删除${2:实体中文}(delete${4:Xxx}):单行 DELETE,条件含归属校验。",
      " *",
      " * 其他:",
      " * 1. 入参假定已经上游 zod 复验,本层不再校验;",
      " * 2. 归属校验:写条件恒带 userId,行不存在或不属于该用户时返回 false;",
      " * 3. DB 异常向上抛,由 action 层归一为失败返回,本层不吞异常。",
      " */",
      "import { and, eq } from \"drizzle-orm\";",
      "",
      "import { db } from \"@/db/client\";",
      "",
      "import { ${3:entityName}, type ${6:XxxInput} } from \"./schema\";",
      "",
      "/** 作用:单行 INSERT 写入一条${2:实体中文};DB 异常向上抛,由 action 层归一。 */",
      "export async function create${4:Xxx}(",
      "  userId: string,",
      "  input: ${6:XxxInput},",
      "): Promise<void> {",
      "  await db.insert(${3:entityName}).values({",
      "    userId,",
      "    // ${7:写入列}",
      "  });",
      "}",
      "",
      "/**",
      " * 作用:单行 UPDATE,条件为 id 与 user_id 同时匹配;",
      " * 行不存在或不属于该用户时,返回 false。",
      " */",
      "export async function update${4:Xxx}(",
      "  userId: string,",
      "  ${8:id}: string,",
      "  input: ${6:XxxInput},",
      "): Promise<boolean> {",
      "  const rows = await db",
      "    .update(${3:entityName})",
      "    .set({",
      "      // ${9:更新列}",
      "      updatedAt: new Date(),",
      "    })",
      "    .where(",
      "      and(",
      "        eq(${3:entityName}.id, ${8:id}),",
      "        eq(${3:entityName}.userId, userId),",
      "      ),",
      "    )",
      "    .returning({ id: ${3:entityName}.id });",
      "  return rows.length > 0;",
      "}",
      "",
      "/**",
      " * 作用:单行 DELETE,条件同更新;",
      " * 行不存在或不属于该用户时,返回 false。",
      " */",
      "export async function delete${4:Xxx}(",
      "  userId: string,",
      "  ${8:id}: string,",
      "): Promise<boolean> {",
      "  const rows = await db",
      "    .delete(${3:entityName})",
      "    .where(",
      "      and(",
      "        eq(${3:entityName}.id, ${8:id}),",
      "        eq(${3:entityName}.userId, userId),",
      "      ),",
      "    )",
      "    .returning({ id: ${3:entityName}.id });",
      "  return rows.length > 0;",
      "}",
      "$0",
    ],
  },
  "mod-tools": {
    "prefix": "mod-tools",
    "scope": "typescript,typescriptreact",
    "description": "模块 tools.ts(可选)——暴露给 agent 的业务工具",
    "body": [
      "/**",
      " * 文件作用:${1:模块中文名}域暴露给 agent 的业务工具,由 api/chat 组装时注册。",
      " *",
      " * 成员:",
      " * 1. ${2:工具中文}工具(${3:xxxTool}):一句话说明。",
      " *",
      " * 其他:",
      " * 1. agent 子系统零业务知识,业务知识只经本文件等模块 tools 注入,",
      " *    executor 只调本模块的 queries/service;",
      " * 2. userId 由路由组装时经闭包注入,工具内不鉴权、不收模型传入的身份参数;",
      " * 3. inputSchema 用 zod 描述,字段靠 describe 写清语义供模型决策;",
      " * 4. execute 返回值必须可 JSON 序列化(工具结果回传模型),禁 Map/类实例;",
      " * 5. 本文件仅服务端执行(server-only 单执行位),禁止被客户端组件 import。",
      " */",
      "import { tool } from \"ai\";",
      "",
      "import { z } from \"zod\";",
      "",
      "import { ${4:listXxx} } from \"./queries\";",
      "",
      "/**",
      " * 作用:构造${2:工具中文}工具,闭包绑定账号。",
      " *",
      " * 流程:",
      " * 1. 模型按 inputSchema 生成入参;",
      " * 2. executor 调${4:listXxx}读${5:数据中文}并返回可序列化结果。",
      " */",
      "export function ${3:xxxTool}(userId: string) {",
      "  return tool({",
      "    description: \"${6:给模型的工具用途描述}\",",
      "    inputSchema: z.object({",
      "      ${7:field}: z.string().describe(\"${8:字段语义说明}\"),",
      "    }),",
      "    execute: async (input) => {",
      "      return ${4:listXxx}(userId, ${9:实参});",
      "    },",
      "  });",
      "}",
      "$0",
    ],
  },
  "mod-index": {
    "prefix": "mod-index",
    "scope": "typescript,typescriptreact",
    "description": "模块 index.ts——公共出口(跨模块 import 的唯一合法入口)",
    "body": [
      "/**",
      " * 文件作用:${1:模块中文名}模块顶入口,跨模块 import 的唯一合法入口。",
      " *",
      " * 成员:",
      " * 1. ${2:数据中文}查询(${3:listXxx}):一句话说明;",
      " * 2. ${2:数据中文}视图(${4:XxxView}):一句话说明;",
      " * 3. ${5:操作中文}动作(${6:xxxAction}):一句话说明;",
      " * 4. ${5:操作中文}结果(${7:XxxActionResult}):一句话说明;",
      " * 5. ${8:组件中文}组件(${9:XxxCard}):一句话说明。",
      " *",
      " * 其他:",
      " * 1. 公共契约只从此处导出,跨模块仅可 import 顶入口,禁深路径;",
      " * 2. 模块内部文件一律相对导入,禁止自引用本文件;",
      " * 3. 跨模块只放读接口(queries 与类型),写上浮 app 层编排,",
      " *    service 不经本文件导出。",
      " */",
      "export { ${3:listXxx} } from \"./queries\";",
      "export type { ${4:XxxView} } from \"./queries\";",
      "export { ${6:xxxAction} } from \"./actions\";",
      "export type { ${7:XxxActionResult} } from \"./actions\";",
      "export { default as ${9:XxxCard} } from \"./components/${9:XxxCard}\";",
      "$0",
    ],
  },
  "mod-component": {
    "prefix": "mod-component",
    "scope": "typescriptreact",
    "description": "模块私有组件——'use client' + Props + shadcn + i18n",
    "body": [
      "\"use client\";",
      "",
      "/**",
      " * 文件作用:${1:组件中文}(${2:XxxCard}),${3:一句话职责}。",
      " *",
      " * 成员:",
      " * 1. ${1:组件中文}属性(${2:XxxCard}Props):一行一字段说明。",
      " *",
      " * 其他:",
      " * 1. 模块私有组件,跨模块仅经模块 index.ts 顶出口;",
      " * 2. 服务端数据经 props 下行(RSC 页面取数),组件不自取;",
      " * 3. 文案经 next-intl 取 ${4:模块} 命名空间 key,不硬编码;",
      " * 4. UI 基元用 shadcn/ui,实心控件禁渐变,品牌色走纯色作用域 token。",
      " */",
      "import { useState } from \"react\";",
      "",
      "import { useTranslations } from \"next-intl\";",
      "",
      "import { Button } from \"@/components/ui/button\";",
      "",
      "type ${2:XxxCard}Props = {",
      "  ${5:prop}: ${6:类型};",
      "};",
      "",
      "/** 作用:${3:一句话职责};数据由调用方经 props 注入。 */",
      "export default function ${2:XxxCard}({ ${5:prop} }: ${2:XxxCard}Props) {",
      "  const t = useTranslations(\"${4:模块}\");",
      "",
      "  return (",
      "    <div className=\"${7:布局类}\">",
      "      <Button>${8:文案 key}</Button>",
      "    </div>",
      "  );",
      "}",
      "$0",
    ],
  },
  "mod-validators": {
    "prefix": "mod-validators",
    "scope": "typescript,typescriptreact",
    "description": "模块 validators.ts——校验纯函数(零 IO,前后端共用)",
    "body": [
      "/**",
      " * 文件作用:${1:模块中文名}域的字段校验纯函数,前后端共用。",
      " *",
      " * 成员:",
      " * 1. ${2:字段中文}正则(${3:XXX_RE}):字符集与长度单一约束;",
      " * 2. ${2:字段中文}校验(${4:validateXxx}):空值与格式两分支校验。",
      " *",
      " * 其他:",
      " * 1. 零 IO、零副作用,仅依赖传入参数,客户端组件可直接 import;",
      " * 2. 校验结果只承载 i18n key,不返回文案原文;",
      " * 3. 正则为单一来源,禁止各处复写,改动任一处须同步;",
      " * 4. 不变量:校验通过 ⇔ 入参与正则匹配。",
      " */",
      "export const ${3:XXX_RE} = ${5:/.../};",
      "",
      "export type ${6:XxxCheck} =",
      "  | { ok: true }",
      "  | {",
      "      ok: false;",
      "      messageKey: \"${7:模块.字段.required}\" | \"${7:模块.字段.invalid}\";",
      "    };",
      "",
      "/** 作用:${2:字段中文}校验:空值返回 required,格式不过返回 invalid。 */",
      "export function ${4:validateXxx}(raw: string): ${6:XxxCheck} {",
      "  if (raw === \"\") {",
      "    return { ok: false, messageKey: \"${7:模块.字段.required}\" };",
      "  }",
      "  if (!${3:XXX_RE}.test(raw)) {",
      "    return { ok: false, messageKey: \"${7:模块.字段.invalid}\" };",
      "  }",
      "  return { ok: true };",
      "}",
      "$0",
    ],
  },
  "mod-errors": {
    "prefix": "mod-errors",
    "scope": "typescript,typescriptreact",
    "description": "模块 errors.ts——错误到 i18n key 映射(client-safe)",
    "body": [
      "/**",
      " * 文件作用:${1:模块中文名}域的错误归一映射,错误形状折算为文案 key。",
      " *",
      " * 成员:",
      " * 1. 错误 key 类型(${2:XxxErrorKey}):本域错误文案 key 全集;",
      " * 3. 归一函数(${3:mapXxxError}):错误形状 → 文案 key。",
      " *",
      " * 其他:",
      " * 1. client-safe:仅纯函数与类型,客户端组件可直接 import;",
      " * 2. 映射只认协议字面值(状态码/错误码),映射依据逐条列在归一函数注释;",
      " * 3. 空值与非预期值兜底 unknown,不泄露探测面;",
      " * 4. key 与 locales 文件同步登记,不返回文案原文。",
      " */",
      "export type ${2:XxxErrorKey} =",
      "  | \"${4:模块.error.具体代码}\"",
      "  | \"${5:模块.error.unknown}\";",
      "",
      "/**",
      " * 作用:把${6:错误来源}的错误形状归一为文案 key;空值兜底 unknown。",
      " *",
      " * 映射依据:",
      " * 1. ${7:状态码/错误码 A} → ${8:key};",
      " * 2. 其余 → unknown。",
      " */",
      "export function ${3:mapXxxError}(",
      "  err: { status?: number; code?: string } | null | undefined,",
      "): ${2:XxxErrorKey} {",
      "  if (!err) {",
      "    return \"${5:模块.error.unknown}\";",
      "  }",
      "  if (err.status === ${7:状态码/错误码 A}) {",
      "    return \"${8:key}\";",
      "  }",
      "  return \"${5:模块.error.unknown}\";",
      "}",
      "$0",
    ],
  },
}
