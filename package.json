{
  "name": "studybuddy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "studybuddyui",
    "website"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:infra": "docker compose -f compose.dev.yaml up -d",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/check-test-mocks.mjs && eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "next typegen && tsc --noEmit",
    "lint:circular": "dpdm src/app/layout.tsx --circular --exit-code circular:1 --warning false --progress false",
    "lint:unused": "knip",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:report": "node scripts/run-vitest.mjs run --coverage",
    "test:endpoint": "node scripts/run-vitest.mjs run --config vitest.config.endpoint.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "docs:dev": "npm run start --workspace website",
    "docs:build": "npm run build --workspace website",
    "docs:serve": "npm run serve --workspace website",
    "ui": "npm run dev --workspace @studybuddy/ui-draft",
    "prepare": "git config core.hooksPath .githooks"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@better-auth/redis-storage": "1.7",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^1.0.0-rc.5",
    "ioredis": "^5.11.1",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-intl": "^4.15.1",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@next/playwright": "16.4.6",
    "@playwright/test": "~1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "5.1.0",
    "dpdm": "^4.3.0",
    "drizzle-kit": "^1.0.0-rc.5",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.1.0"
  }
}
